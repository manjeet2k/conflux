{
  "manifest_version": 3,
  "name": "Conflux Download Accelerator",
  "version": "0.2.0",
  "description": "Multi-interface download accelerator integration for Conflux.",
  "key": "",
  "icons": {
    "16": "icons/icon-32.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-128.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Conflux Download Manager",
    "default_icon": {
      "16": "icons/icon-32.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-128.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "cookies",
    "nativeMessaging",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "conflux@conflux.app",
      "strict_min_version": "109.0"
    }
  }
}
